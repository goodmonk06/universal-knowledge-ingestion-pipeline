{
  "name": "universal-knowledge-ingestion-pipeline",
  "version": "1.0.0",
  "description": "汎用的な知識インジェストパイプライン - PDF・Web・テキストからベクトルDBへ",
  "main": "dist/index.js",
  "bin": {
    "ingest": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "dev:cli": "ts-node src/cli.ts",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "rag",
    "vector-db",
    "embeddings",
    "knowledge-ingestion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "jsdom": "^23.0.0",
    "pg": "^8.11.3",
    "tiktoken": "^1.0.10",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "zod": "^3.22.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/jsdom": "^21.1.6",
    "@types/pg": "^8.10.9",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
